# EchoLab — environment template
# Copy to backend/.env and fill in your own key.
# The backend loads backend/.env, so backend keys belong next to backend/main.py.

# --- Backend (backend/.env) -------------------------------------------------

# Google Gemini API key (AI Studio): https://aistudio.google.com/apikey
# Required for real video analysis. If unset, /api/analyze returns a labelled
# demo payload (demo_mode: true) and /health reports "ai": "demo".
GEMINI_API_KEY=

# Browser origins allowed to call the API (comma-separated).
# Defaults to the local Next dev server when unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (project root .env.local) -------------------------------------

# Origin of the backend. Defaults to http://localhost:8000 when unset.
# Change this when the API is hosted somewhere other than your machine.
NEXT_PUBLIC_API_BASE=http://localhost:8000
